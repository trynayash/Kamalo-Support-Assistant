modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[nix]
channel = "stable-25_05"
packages = ["glib", "nspr", "nss", "dbus", "atk"]

[userenv]

[userenv.production]
RESEND_FROM_EMAIL = "noreply@limityourapi.tech"

[userenv.development]
RESEND_FROM_EMAIL = "noreply@limityourapi.tech"
