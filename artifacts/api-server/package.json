{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "check:knowledge": "pnpm run build && node --enable-source-maps ./dist/scripts/check-knowledge.mjs",
    "validate": "pnpm run typecheck && pnpm run check:knowledge",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:prepare": "node ./test/prepare-database.mjs",
    "test": "pnpm run test:prepare && ../kamalo-ai/node_modules/.bin/tsx --test test/support-core.test.ts",
    "test:intent": "node ../../scripts/test-intent.mjs"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
