# Copy to `.env` and fill in real values for local development.
# Never commit `.env`.

# PostgreSQL
# Local Docker: postgresql://kamalo:kamalo@127.0.0.1:5432/kamalo
# Supabase (Session pooler URI from Project Settings -> Database):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://kamalo:kamalo@127.0.0.1:5432/kamalo

# API server (use 8081 if Apache/XAMPP already uses 8080)
API_PORT=8081
PORT=8081
NODE_ENV=development

# Web app (Vite dev server)
WEB_PORT=5173
API_PROXY_TARGET=http://127.0.0.1:8081
BASE_PATH=/

# Combined production deploy (Render / single-service hosting)
# STATIC_DIR=artifacts/kamalo-ai/dist/public

# AI provider (required for chat responses)
OPENROUTER_API_KEY=
# Optional: override OpenRouter models (defaults to openrouter/free)
# OPENROUTER_ROUTING_MODEL=openrouter/free
# OPENROUTER_ANSWER_MODEL=openrouter/free
# OPENROUTER_HUMANIZE_MODEL=openrouter/free

# Voice transcription (free Groq Whisper recommended: console.groq.com)
GROQ_API_KEY=
# Optional fallback: Hugging Face inference token
HUGGINGFACE_API_KEY=

# Email (required for ticket + feedback notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
KAMALO_FEEDBACK_EMAIL=

# Optional ticket routing overrides
# KAMALO_L1_EMAIL=
# KAMALO_L1_NAME=
# KAMALO_UPLOAD_DIR=
